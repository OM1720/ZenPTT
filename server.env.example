ZENPTT_DOMAIN=ptt.example.com
ZENPTT_ENV_FILE=server.env
ZENPTT_HTTP_PORT=80
ZENPTT_HTTPS_PORT=443
# Leave historical defaults empty for a new installation.
ZENPTT_ANDROID_LEGACY_SERVER_ADDRESS=
ZENPTT_ANDROID_PRE_SNAPSHOT_SERVER_ADDRESS=
# Adjust these ceilings to the host while staying within the compiled limits.
ZENPTT_SERVER_MEMORY_LIMIT=768m
ZENPTT_SERVER_PIDS_LIMIT=128
ZENPTT_CADDY_MEMORY_LIMIT=256m
ZENPTT_CADDY_PIDS_LIMIT=64
MAX_CHANNEL_CODE_LENGTH=256
MAX_CHANNEL_PARTICIPANTS=12
RECOVERY_HORIZON_MS=5000
MAX_ACTIVE_SESSIONS=180
MAX_ACTIVE_SESSIONS_PER_CLIENT_IP=30
MAX_CONTROL_MESSAGES_PER_SECOND=50
MAX_AUDIO_MESSAGES_PER_SECOND=200
DIAGNOSTICS_MAX_BODY_BYTES=131072
DIAGNOSTICS_MAX_REPORTS=500
DIAGNOSTICS_RETENTION_SECONDS=604800
DIAGNOSTICS_MAX_UPLOADS_PER_MINUTE=30
DIAGNOSTICS_MAX_UPLOADS_PER_CLIENT_PER_MINUTE=10
DIAGNOSTICS_MAX_CONCURRENT_SAVES=2
LOG_LEVEL=INFO
